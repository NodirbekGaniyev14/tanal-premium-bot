# --- Telegram ---
# @BotFather dan olingan token
BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Yopiq admin guruhi ID si (bot o'sha guruhda admin bo'lsin). Manfiy son.
ADMIN_CHAT_ID=-1001234567890
# Admin Telegram ID lari, vergul bilan
ADMIN_IDS=111111111,222222222

# --- Ma'lumotlar bazasi ---
POSTGRES_USER=tanal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tanal
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Gemini (Faza 6-7) ---
# Kalit bo'sh bo'lsa bot DEMO rejimida ishlaydi: writing va speaking oqimi
# to'liq ishlaydi, lekin baho namunaviy (Gemini chaqirilmaydi).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Kalit bor bo'lsa ham demo rejimini majburlash uchun: true
AI_DEMO=false
# Bir o'quvchi uchun kunlik AI so'rov limiti
AI_DAILY_LIMIT=6
# Ovozli javob uchun chegaralar (soniya)
SPEAKING_MIN_SEC=15
SPEAKING_MAX_SEC=180
# Bitta inshoda nechta varaq rasmi qabul qilinadi
WRITING_MAX_PAGES=6

# --- Umumiy ---
TZ=Asia/Tashkent
LOG_LEVEL=INFO
# Kontent fayllari (PDF/audio) turgan papka — admin import uchun
CONTENT_DIR=/app/content
